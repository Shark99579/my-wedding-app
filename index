import React, { useState, useEffect } from 'react';
import { 
  Heart, 
  CheckSquare, 
  DollarSign, 
  Clock, 
  MapPin, 
  Plus, 
  CheckCircle2, 
  Circle, 
  CalendarHeart,
  ChevronRight,
  Gift,
  Trash2,
  Loader2
} from 'lucide-react';

// Firebase 相關套件
import { initializeApp } from 'firebase/app';
import { getAuth, signInAnonymously, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, doc, setDoc, onSnapshot } from 'firebase/firestore';

// 一個共用的「可編輯輸入框」小組件
const EditInput = ({ value, onChange, className, type = "text", placeholder = "點擊編輯" }) => (
  <input
    type={type}
    value={value}
    onChange={(e) => onChange(e.target.value)}
    placeholder={placeholder}
    className={`bg-transparent outline-none border-b border-transparent hover:border-stone-200 focus:border-rose-300 transition-colors w-full ${className}`}
  />
);

export default function App() {
  const [activeTab, setActiveTab] = useState('dashboard');
  
  // --- 使用者與同步狀態 ---
  const [user, setUser] = useState(null);
  const [isReady, setIsReady] = useState(false);
  const [configError, setConfigError] = useState(false);
  
  // --- 全局狀態 (改為底線變數，以便自訂同步邏輯) ---
  const [weddingDate, _setWeddingDate] = useState('2026-10-10');
  const [totalBudget, _setTotalBudget] = useState(500000);
  
  const [tasks, _setTasks] = useState([
    { id: 1, text: '場地', done: false, status: '場勘中', category: '宴客', note: '' },
    { id: 2, text: '餐費', done: false, status: '', category: '宴客', note: '' },
    { id: 3, text: '印刷品 (喜帖小卡等)', done: false, status: '需討論', category: '宴客', note: '' },
    { id: 4, text: '西裝', done: false, status: '5/1 看', category: '服飾', note: '' },
    { id: 5, text: '試妝', done: false, status: '找時間約', category: '造型', note: '' },
    { id: 13, text: '立可拍', done: true, status: '已完成', category: '活動', note: '' },
    { id: 14, text: '戒指', done: true, status: '訂好了', category: '服飾', note: '三套造型' },
    { id: 15, text: '新秘', done: true, status: '訂好了', category: '造型', note: '媽&姊' },
  ]);
  
  const [expenses, _setExpenses] = useState([
    { id: 1, name: '拍婚紗', amount: 42800 },
    { id: 2, name: '立可拍', amount: 2000 },
    { id: 3, name: '戒指', amount: 42000 },
    { id: 4, name: '新秘', amount: 19800 },
    { id: 5, name: '親友妝', amount: 4800 },
  ]);

  const [schedule, _setSchedule] = useState([
    { id: 1, time: '08:00', event: '新娘開始化妝', location: '飯店房間' },
    { id: 2, time: '10:00', event: '新郎闖關迎娶', location: '飯店房間' },
    { id: 3, time: '12:00', event: '迎賓入席', location: '一樓宴會廳' },
    { id: 4, time: '12:30', event: '第一次進場', location: '一樓宴會廳' },
  ]);

  const [venueInfo, _setVenueInfo] = useState({
    name: '幸福大飯店',
    hall: '一樓 浪漫花園廳',
    address: '台北市信義區幸福路 99 號',
    contactRole: '訂席負責人',
    contactName: '陳經理',
    contactPhone: '02-2345-6789',
    vendors: [
      { id: 1, role: '新娘秘書', name: 'Alice', phone: '0912-345-678' },
      { id: 2, role: '婚禮攝影', name: 'Bob Studio', phone: '0987-654-321' }
    ]
  });

  // --- 🌟 雲端即時同步邏輯 🌟 ---
  useEffect(() => {
    try {
      // 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 👇 
      // 【步驟三：將你複製的 firebaseConfig 整段貼在下方，取代這段空的物件】
const firebaseConfig = {
  apiKey: "AIzaSyCh-XpAPbucYna2FLM7rvc5N6XCP3ZEWjk",
  authDomain: "my-wedding-app-414ee.firebaseapp.com",
  databaseURL: "https://my-wedding-app-414ee-default-rtdb.firebaseio.com",
  projectId: "my-wedding-app-414ee",
  storageBucket: "my-wedding-app-414ee.firebasestorage.app",
  messagingSenderId: "1046152896943",
  appId: "1:1046152896943:web:fa202b85658782fc30cf5a",
  measurementId: "G-JDFNE3Z6HG"
};
      // 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 👆 

      if (!firebaseConfig || !firebaseConfig.apiKey) {
        setConfigError(true);
        return;
      }
      
      const app = initializeApp(firebaseConfig);
      const auth = getAuth(app);
      
      // 使用匿名登入，這樣不用做登入畫面也能讓你們共同編輯
      signInAnonymously(auth).catch((error) => {
        console.error("Firebase 登入失敗:", error);
      });
      
      const unsubscribe = onAuthStateChanged(auth, setUser);
      return () => unsubscribe();
    } catch (error) {
      console.error("Firebase 初始化失敗，請檢查設定碼！", error);
      setConfigError(true);
    }
  }, []);

  // 監聽雲端資料庫的改變
  useEffect(() => {
    if (!user) return;
    const db = getFirestore();
    
    // 💡 這是你的專屬資料庫路徑 (集合: wedding, 文件: shared_state)
    const docRef = doc(db, 'wedding', 'shared_state');

    const unsubscribe = onSnapshot(docRef, (docSnap) => {
      if (docSnap.exists()) {
        const data = docSnap.data();
        if (data.weddingDate !== undefined) _setWeddingDate(data.weddingDate);
        if (data.totalBudget !== undefined) _setTotalBudget(data.totalBudget);
        if (data.tasks) _setTasks(data.tasks);
        if (data.expenses) _setExpenses(data.expenses);
        if (data.schedule) _setSchedule(data.schedule);
        if (data.venueInfo) _setVenueInfo(data.venueInfo);
      }
      setIsReady(true);
    }, (error) => {
      console.error("雲端同步錯誤:", error);
      setIsReady(true);
    });
    
    return () => unsubscribe();
  }, [user]);

  // 更新資料到雲端
  const updateCloud = async (key, value) => {
    if (!user) return;
    const db = getFirestore();
    const docRef = doc(db, 'wedding', 'shared_state');
    try {
      await setDoc(docRef, { [key]: value }, { merge: true });
    } catch (e) {
      console.error("寫入雲端失敗:", e);
    }
  };

  // --- 狀態包裝器 (每次你編輯時，自動幫你儲存到雲端) ---
  const setWeddingDate = (val) => { _setWeddingDate(val); updateCloud('weddingDate', val); };
  const setTotalBudget = (val) => { _setTotalBudget(val); updateCloud('totalBudget', val); };
  const setTasks = (val) => { _setTasks(val); updateCloud('tasks', val); };
  const setExpenses = (val) => { _setExpenses(val); updateCloud('expenses', val); };
  const setSchedule = (val) => { _setSchedule(val); updateCloud('schedule', val); };
  const setVenueInfo = (val) => {
    if (typeof val === 'function') {
      _setVenueInfo(prev => {
        const newVal = val(prev);
        updateCloud('venueInfo', newVal);
        return newVal;
      });
    } else {
      _setVenueInfo(val);
      updateCloud('venueInfo', val);
    }
  };

  // --- 計算邏輯 ---
  const targetDate = new Date(weddingDate);
  const daysLeft = isNaN(targetDate) ? 0 : Math.ceil((targetDate.getTime() - new Date().getTime()) / (1000 * 60 * 60 * 24));
  
  const completedTasks = tasks.filter(t => t.done).length;
  const taskProgress = tasks.length === 0 ? 0 : Math.round((completedTasks / tasks.length) * 100);
  const totalSpent = expenses.reduce((sum, item) => sum + (Number(item.amount) || 0), 0);

  // --- 操作函數 ---
  const toggleTask = (id) => setTasks(tasks.map(t => t.id === id ? { ...t, done: !t.done } : t));
  const updateTask = (id, field, value) => setTasks(tasks.map(t => t.id === id ? { ...t, [field]: value } : t));
  const addTask = () => setTasks([...tasks, { id: Date.now(), text: '', done: false, status: '', category: '新分類', note: '' }]);
  const removeTask = (id) => setTasks(tasks.filter(t => t.id !== id));

  const updateExpense = (id, field, value) => setExpenses(expenses.map(e => e.id === id ? { ...e, [field]: value } : e));
  const addExpense = () => setExpenses([...expenses, { id: Date.now(), name: '', amount: '' }]);
  const removeExpense = (id) => setExpenses(expenses.filter(e => e.id !== id));

  const updateSchedule = (id, field, value) => setSchedule(schedule.map(s => s.id === id ? { ...s, [field]: value } : s));
  const addSchedule = () => setSchedule([...schedule, { id: Date.now(), time: '12:00', event: '', location: '' }]);
  const removeSchedule = (id) => setSchedule(schedule.filter(s => s.id !== id));

  const updateVendor = (id, field, value) => {
    setVenueInfo(prev => ({
      ...prev,
      vendors: prev.vendors.map(v => v.id === id ? { ...v, [field]: value } : v)
    }));
  };
  const addVendor = () => {
    setVenueInfo(prev => ({
      ...prev,
      vendors: [...prev.vendors, { id: Date.now(), role: '', name: '', phone: '' }]
    }));
  };
  const removeVendor = (id) => {
    setVenueInfo(prev => ({
      ...prev,
      vendors: prev.vendors.filter(v => v.id !== id)
    }));
  };

  // --- 畫面渲染前的狀態檢查 ---
  if (configError) {
    return (
      <div className="flex flex-col h-screen bg-stone-50 items-center justify-center max-w-md mx-auto shadow-2xl p-6 text-center">
        <div className="bg-white p-6 rounded-2xl shadow-sm border border-rose-200">
          <h2 className="text-xl font-bold text-rose-600 mb-2">哎呀！還差一步！</h2>
          <p className="text-stone-600 text-sm">請記得在 <code>App.jsx</code> 的第 76 行貼上你的 Firebase 設定碼，這樣 APP 才能連上你的專屬資料庫喔！</p>
        </div>
      </div>
    );
  }

  if (!isReady) {
    return (
      <div className="flex flex-col h-screen bg-stone-50 items-center justify-center max-w-md mx-auto shadow-2xl relative overflow-hidden">
        <Heart className="absolute -right-4 -top-4 w-48 h-48 text-rose-100 opacity-50" />
        <Loader2 className="w-10 h-10 text-rose-500 animate-spin mb-4 relative z-10" />
        <p className="text-stone-500 font-medium tracking-wider relative z-10">正在準備你的專屬婚禮日誌...</p>
      </div>
    );
  }

  // --- 畫面組件 ---

  const renderDashboard = () => (
    <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
      <div className="bg-gradient-to-br from-rose-400 to-rose-500 text-white p-6 rounded-3xl shadow-lg relative overflow-hidden text-center flex flex-col items-center">
        <Heart className="absolute -right-4 -top-4 w-24 h-24 text-white opacity-10" />
        <h2 className="text-rose-100 text-sm font-medium tracking-widest mb-2 relative z-10">距離我們的大日子還有</h2>
        <div className="flex items-baseline justify-center space-x-2 relative z-10">
          <span className="text-6xl font-bold">{daysLeft > 0 ? daysLeft : 0}</span>
          <span className="text-xl">天</span>
        </div>
        <div className="mt-4 relative z-10">
          <input 
            type="date" 
            value={weddingDate}
            onChange={(e) => setWeddingDate(e.target.value)}
            className="bg-white/20 text-white border border-rose-300/50 rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-white/50"
          />
        </div>
      </div>

      <div className="bg-white p-5 rounded-2xl shadow-sm border border-stone-100">
        <h3 className="font-bold text-stone-800 mb-4 flex items-center">
          <CheckSquare className="w-5 h-5 mr-2 text-rose-500" /> 籌備進度
        </h3>
        <div className="space-y-2">
          <div className="flex justify-between text-sm text-stone-600">
            <span>已完成 {completedTasks} / {tasks.length} 項</span>
            <span className="font-bold text-rose-500">{taskProgress}%</span>
          </div>
          <div className="w-full bg-stone-100 rounded-full h-2.5">
            <div className="bg-rose-400 h-2.5 rounded-full transition-all duration-1000" style={{ width: `${taskProgress}%` }}></div>
          </div>
        </div>
      </div>

      <div className="bg-white p-5 rounded-2xl shadow-sm border border-stone-100">
        <h3 className="font-bold text-stone-800 mb-4 flex items-center">
          <DollarSign className="w-5 h-5 mr-2 text-rose-500" /> 預算概況
        </h3>
        <div className="flex justify-between items-end mb-4">
          <div>
            <p className="text-xs text-stone-500 mb-1">已花費</p>
            <p className="text-2xl font-bold text-stone-800">${totalSpent.toLocaleString()}</p>
          </div>
          <div className="text-right flex flex-col items-end">
            <p className="text-xs text-stone-500 mb-1">設定總預算</p>
            <div className="flex items-center text-stone-600 font-medium">
              $ <input 
                  type="number" 
                  value={totalBudget} 
                  onChange={(e) => setTotalBudget(Number(e.target.value))}
                  className="w-20 text-right bg-stone-50 border border-stone-200 rounded px-1 ml-1 focus:outline-none focus:border-rose-300"
                />
            </div>
          </div>
        </div>
        <div className="w-full bg-stone-100 rounded-full h-2">
          <div className="bg-stone-800 h-2 rounded-full" style={{ width: `${Math.min((totalSpent / totalBudget) * 100, 100)}%` }}></div>
        </div>
      </div>
    </div>
  );

  const renderTasks = () => (
    <div className="space-y-4 animate-in fade-in slide-in-from-bottom-4 duration-500">
      <div className="flex justify-between items-center mb-2">
        <h2 className="text-xl font-bold text-stone-800">待辦事項</h2>
        <button onClick={addTask} className="text-rose-500 bg-rose-50 p-2 rounded-full hover:bg-rose-100 transition shadow-sm">
          <Plus className="w-5 h-5" />
        </button>
      </div>
      
      <div className="bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden">
        {tasks.map((task, index) => (
          <div key={task.id} className={`flex items-start p-4 transition-colors hover:bg-stone-50 ${index !== tasks.length - 1 ? 'border-b border-stone-50' : ''}`}>
            <button onClick={() => toggleTask(task.id)} className="mt-1 flex-shrink-0 focus:outline-none">
              {task.done ? <CheckCircle2 className="w-6 h-6 text-rose-500" /> : <Circle className="w-6 h-6 text-stone-300" />}
            </button>
            
            <div className={`ml-3 flex-1 ${task.done ? 'opacity-50' : ''}`}>
              <div className="flex justify-between items-start gap-2">
                <EditInput 
                  value={task.text} 
                  onChange={(v) => updateTask(task.id, 'text', v)} 
                  className={`font-medium ${task.done ? 'line-through text-stone-500' : 'text-stone-800'}`} 
                  placeholder="事項名稱..."
                />
                <input
                  value={task.status}
                  onChange={e => updateTask(task.id, 'status', e.target.value)}
                  className={`text-[10px] px-2 py-0.5 rounded-full outline-none focus:ring-2 focus:ring-rose-200 w-24 text-center transition-all flex-shrink-0 ${
                    task.status
                      ? (task.done ? 'bg-rose-50 text-rose-600' : 'bg-stone-100 text-stone-600')
                      : 'bg-transparent text-stone-400 border border-dashed border-stone-300 hover:bg-stone-50'
                  }`}
                  placeholder="+ 標籤"
                />
                <button onClick={() => removeTask(task.id)} className="text-stone-300 hover:text-rose-500 p-1">
                  <Trash2 className="w-4 h-4" />
                </button>
              </div>
              
              <div className="flex items-center text-xs text-stone-400 mt-1 space-x-1">
                <EditInput value={task.category} onChange={(v) => updateTask(task.id, 'category', v)} className="w-16" placeholder="分類" />
                <span>•</span>
                <EditInput value={task.note} onChange={(v) => updateTask(task.id, 'note', v)} className="flex-1" placeholder="備註..." />
              </div>
            </div>
          </div>
        ))}
        {tasks.length === 0 && <div className="p-6 text-center text-stone-400 text-sm">目前沒有待辦事項</div>}
      </div>
    </div>
  );

  const renderBudget = () => (
    <div className="space-y-4 animate-in fade-in slide-in-from-bottom-4 duration-500">
      <div className="flex justify-between items-center mb-2">
        <h2 className="text-xl font-bold text-stone-800">花費明細</h2>
        <button onClick={addExpense} className="text-rose-500 bg-rose-50 p-2 rounded-full hover:bg-rose-100 transition shadow-sm">
          <Plus className="w-5 h-5" />
        </button>
      </div>

      <div className="grid grid-cols-2 gap-4 mb-4">
        <div className="bg-white p-4 rounded-2xl shadow-sm border border-stone-100">
          <p className="text-xs text-stone-500 mb-1">目前花費</p>
          <p className="text-lg font-bold text-rose-600">${totalSpent.toLocaleString()}</p>
        </div>
        <div className="bg-white p-4 rounded-2xl shadow-sm border border-stone-100">
          <p className="text-xs text-stone-500 mb-1">剩餘預算</p>
          <p className="text-lg font-bold text-emerald-600">${(totalBudget - totalSpent).toLocaleString()}</p>
        </div>
      </div>

      <div className="bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden">
        {expenses.map((expense, index) => (
          <div key={expense.id} className={`flex items-center justify-between p-4 ${index !== expenses.length - 1 ? 'border-b border-stone-50' : ''}`}>
            <div className="flex items-center space-x-3 flex-1">
              <div className="w-10 h-10 rounded-full bg-stone-50 border border-stone-100 flex items-center justify-center text-stone-400">
                <Gift className="w-5 h-5" />
              </div>
              <EditInput 
                value={expense.name} 
                onChange={(v) => updateExpense(expense.id, 'name', v)} 
                className="font-medium text-stone-800 text-base" 
                placeholder="項目名稱"
              />
            </div>
            <div className="flex items-center space-x-2">
              <span className="text-stone-400 font-bold">$</span>
              <input 
                type="number"
                value={expense.amount}
                onChange={(e) => updateExpense(expense.id, 'amount', e.target.value)}
                className="w-24 text-right font-bold text-stone-700 bg-transparent border-b border-transparent hover:border-stone-200 focus:outline-none focus:border-rose-300"
                placeholder="金額"
              />
              <button onClick={() => removeExpense(expense.id)} className="text-stone-300 hover:text-rose-500 p-1 ml-1">
                <Trash2 className="w-4 h-4" />
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  );

  const renderSchedule = () => (
    <div className="space-y-4 animate-in fade-in slide-in-from-bottom-4 duration-500">
      <div className="flex justify-between items-center mb-4">
        <h2 className="text-xl font-bold text-stone-800">婚禮當日流程</h2>
        <button onClick={addSchedule} className="text-rose-500 bg-rose-50 p-2 rounded-full hover:bg-rose-100 transition shadow-sm">
          <Plus className="w-5 h-5" />
        </button>
      </div>
      
      <div className="bg-white p-6 rounded-2xl shadow-sm border border-stone-100">
        <div className="space-y-8 relative">
          <div className="absolute left-[103px] top-2 bottom-2 w-0.5 bg-rose-100 z-0"></div>
          {schedule.map((item) => (
            <div key={item.id} className="flex items-start group relative z-10">
              <div className="w-24 flex-shrink-0 text-right pr-4 pt-1.5 bg-white relative z-10">
                <input 
                  type="time" 
                  value={item.time} 
                  onChange={(e) => updateSchedule(item.id, 'time', e.target.value)}
                  className="font-bold text-stone-600 text-sm bg-transparent w-full text-right outline-none focus:text-rose-500 appearance-none [&::-webkit-calendar-picker-indicator]:hidden"
                />
              </div>
              <div className="relative flex-1 bg-stone-50 rounded-xl p-3 border border-stone-100 ml-4 group-hover:border-rose-200 transition-colors">
                <div className="absolute -left-[8px] top-3.5 w-3 h-3 bg-rose-400 rounded-full border-2 border-white shadow-sm transform -translate-x-1/2 z-20"></div>
                <div className="flex justify-between items-start">
                  <EditInput 
                    value={item.event} 
                    onChange={(v) => updateSchedule(item.id, 'event', v)} 
                    className="font-bold text-stone-800" 
                    placeholder="流程名稱"
                  />
                  <button onClick={() => removeSchedule(item.id)} className="text-stone-300 hover:text-rose-500 ml-2">
                    <Trash2 className="w-4 h-4" />
                  </button>
                </div>
                <div className="flex items-center mt-1 text-sm text-stone-500">
                  <MapPin className="w-3 h-3 mr-1 flex-shrink-0" /> 
                  <EditInput 
                    value={item.location} 
                    onChange={(v) => updateSchedule(item.id, 'location', v)} 
                    placeholder="地點"
                  />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );

  const renderVenue = () => (
    <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
      <h2 className="text-xl font-bold text-stone-800">場地與廠商資訊</h2>
      
      <div className="bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden">
        <div className="h-32 bg-stone-200 relative">
          <div className="absolute inset-0 bg-gradient-to-b from-transparent to-black/60"></div>
          <div className="absolute bottom-4 left-4 right-4 text-white">
            <EditInput 
              value={venueInfo.name} 
              onChange={(v) => setVenueInfo({...venueInfo, name: v})} 
              className="font-bold text-xl text-white placeholder-white/70" 
              placeholder="場地名稱" 
            />
            <EditInput 
              value={venueInfo.hall} 
              onChange={(v) => setVenueInfo({...venueInfo, hall: v})} 
              className="text-sm opacity-90 mt-1 text-white placeholder-white/70" 
              placeholder="廳房名稱" 
            />
          </div>
        </div>
        <div className="p-5 space-y-4">
          <div className="flex items-start space-x-3">
            <MapPin className="w-5 h-5 text-rose-500 mt-0.5 flex-shrink-0" />
            <div className="flex-1">
              <p className="text-sm font-bold text-stone-800">地址</p>
              <EditInput 
                value={venueInfo.address} 
                onChange={(v) => setVenueInfo({...venueInfo, address: v})} 
                className="text-sm text-stone-500" 
                placeholder="輸入地址" 
              />
            </div>
          </div>
          <div className="flex items-start space-x-3">
            <CalendarHeart className="w-5 h-5 text-rose-500 mt-0.5 flex-shrink-0" />
            <div className="flex-1 flex gap-2">
              <div className="w-1/3">
                <p className="text-sm font-bold text-stone-800">職稱</p>
                <EditInput value={venueInfo.contactRole} onChange={(v) => setVenueInfo({...venueInfo, contactRole: v})} className="text-sm text-stone-500" />
              </div>
              <div className="w-1/3">
                <p className="text-sm font-bold text-stone-800">聯絡人</p>
                <EditInput value={venueInfo.contactName} onChange={(v) => setVenueInfo({...venueInfo, contactName: v})} className="text-sm text-stone-500" />
              </div>
              <div className="w-1/3">
                <p className="text-sm font-bold text-stone-800">電話</p>
                <EditInput value={venueInfo.contactPhone} onChange={(v) => setVenueInfo({...venueInfo, contactPhone: v})} className="text-sm text-stone-500" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <div className="bg-white rounded-2xl shadow-sm border border-stone-100 p-5">
        <div className="flex justify-between items-center mb-4">
          <h3 className="font-bold text-stone-800">其他重要廠商/聯絡人</h3>
          <button onClick={addVendor} className="text-rose-500 hover:bg-rose-50 p-1 rounded-full transition">
            <Plus className="w-4 h-4" />
          </button>
        </div>
        <div className="space-y-3">
          {venueInfo.vendors.map((vendor, index) => (
            <div key={vendor.id} className={`flex items-center gap-2 pb-3 ${index !== venueInfo.vendors.length - 1 ? 'border-b border-stone-50' : ''}`}>
              <div className="flex-1 space-y-1">
                <div className="flex gap-2">
                  <EditInput value={vendor.role} onChange={(v) => updateVendor(vendor.id, 'role', v)} className="font-medium text-stone-700 text-sm w-24" placeholder="身分/廠商" />
                  <span className="text-stone-300">-</span>
                  <EditInput value={vendor.name} onChange={(v) => updateVendor(vendor.id, 'name', v)} className="font-medium text-stone-700 text-sm flex-1" placeholder="名稱" />
                </div>
                <EditInput value={vendor.phone} onChange={(v) => updateVendor(vendor.id, 'phone', v)} className="text-xs text-stone-400" placeholder="電話號碼" />
              </div>
              <button onClick={() => removeVendor(vendor.id)} className="text-stone-300 hover:text-rose-500 p-2">
                <Trash2 className="w-4 h-4" />
              </button>
            </div>
          ))}
        </div>
      </div>
    </div>
  );

  return (
    <div className="flex flex-col h-screen bg-stone-50 text-stone-800 font-sans max-w-md mx-auto shadow-2xl relative overflow-hidden">
      <header className="bg-white pt-10 pb-4 px-6 flex justify-between items-center z-10 shadow-sm relative">
        <div>
          <h1 className="text-2xl font-extrabold text-stone-800 tracking-tight">Our Wedding</h1>
          <p className="text-rose-500 text-xs font-medium tracking-widest mt-1 uppercase">Planning Journal</p>
        </div>
        <div className="w-10 h-10 bg-rose-100 rounded-full flex items-center justify-center border border-rose-200 cursor-pointer hover:bg-rose-200 transition">
          <span className="text-rose-600 font-bold text-sm">M&K</span>
        </div>
      </header>

      <main className="flex-1 p-6 overflow-y-auto pb-28">
        {activeTab === 'dashboard' && renderDashboard()}
        {activeTab === 'tasks' && renderTasks()}
        {activeTab === 'budget' && renderBudget()}
        {activeTab === 'schedule' && renderSchedule()}
        {activeTab === 'venue' && renderVenue()}
      </main>

      <nav className="absolute bottom-0 w-full bg-white/90 backdrop-blur-md border-t border-stone-100 flex justify-around p-2 pb-safe shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.1)] z-10">
        {[
          { id: 'dashboard', icon: Heart, label: '總覽' },
          { id: 'tasks', icon: CheckSquare, label: '待辦' },
          { id: 'budget', icon: DollarSign, label: '預算' },
          { id: 'schedule', icon: Clock, label: '流程' },
          { id: 'venue', icon: MapPin, label: '場地' },
        ].map((tab) => {
          const Icon = tab.icon;
          const isActive = activeTab === tab.id;
          return (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id)}
              className={`flex flex-col items-center p-2 rounded-xl transition-all duration-300 w-16 ${
                isActive ? 'text-rose-600 -translate-y-1' : 'text-stone-400 hover:text-stone-600'
              }`}
            >
              <div className={`relative p-1.5 rounded-full ${isActive ? 'bg-rose-50' : ''}`}>
                <Icon className={`w-5 h-5 ${isActive ? 'fill-rose-100' : ''}`} />
              </div>
              <span className={`text-[10px] mt-0.5 ${isActive ? 'font-bold' : 'font-medium'}`}>
                {tab.label}
              </span>
            </button>
          );
        })}
      </nav>
    </div>
  );
}
